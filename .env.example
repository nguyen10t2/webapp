# Biến môi trường frontend (copy thành `.env` khi dev)
# Backend cho phép nhiều origin CORS (FRONTEND_URL phân tách dấu phẩy, main.rs).
#
# LƯU Ý QUAN TRỌNG: Vite bake env vào bundle lúc BUILD (`vite build`), nên giá trị
# VITE_API_URL phải đúng NGAY LÚC BUILD cho từng môi trường:
# - Dev local:        VITE_API_URL=http://localhost:3000
# - Deploy Cloudflare (BE ở Render): VITE_API_URL=https://<your-api>.onrender.com
#   (set trong Cloudflare Pages dashboard → Settings → Environment variables → Rebuild).
# Sai URL lúc build = login nhìn như thành công nhưng F5 là logout (cookie cross-site
# không khớp origin, refresh 401).

VITE_API_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:5173
